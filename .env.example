# eBay Browse API credentials (https://developer.ebay.com/my/keys)
# Copy this file to .env and fill in your own values. .env is gitignored.

# Required. Application (client) credentials from your eBay developer keyset.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Optional. "production" (default) or "sandbox".
EBAY_ENV=production

# Optional. Marketplace to search. EBAY_FR (default), EBAY_DE, EBAY_GB, EBAY_IT, EBAY_ES.
EBAY_MARKETPLACE_ID=EBAY_FR

# Optional. Results requested per brand/category query (1-200). Default 10.
EBAY_LIMIT_PER_QUERY=10

# Optional. Hard cap on how many new listings get appended in one run. Default 200.
EBAY_MAX_ITEMS=200

# Optional. Milliseconds to pause between API calls, to stay inside rate limits. Default 250.
EBAY_REQUEST_DELAY_MS=250

# Optional. Set to "true" to search on keywords only, without eBay category filters.
EBAY_DISABLE_CATEGORY_FILTER=false
